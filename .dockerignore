# Secrets — never bake into the image, passed at runtime via env_file instead
.env
.env.*
!.env.example

# dbt/profiles.yml is gitignored (per-developer, auto-generated at container
# runtime by src/lakehouse/fabric_dbt_runner.py's _ensure_local_profile()
# from the committed profiles.yml.example) but was NOT dockerignored --
# meaning `az acr build` was tarring up and baking in WHATEVER local auth
# config happened to exist on the machine running the build, silently
# overriding the container's own auto-generation (which only runs when the
# file doesn't already exist). Confirmed 2026-09-10: this shipped one
# developer's local "environment" auth mode into production, which needs
# AZURE_TENANT_ID/AZURE_CLIENT_ID/AZURE_CLIENT_SECRET App Settings that were
# never configured there, silently breaking every dbt Silver build in
# production regardless of concurrency.
dbt/profiles.yml

# Same class of bug as dbt/profiles.yml above -- these are gitignored
# (regenerated fresh by every local `dbt run`, per
# src/lakehouse/fabric_dbt_runner.py) but were NOT dockerignored, so
# `az acr build`'s local-directory tar would bake in whatever compiled
# SQL, partial-parse cache, and log files happened to exist on the machine
# running the build -- stale local state overriding the container's own
# fresh run, not just wasted image size.
dbt/vive_recon/target/
dbt/vive_recon/logs/
dbt/vive_recon/dbt_packages/

# Version control
.git
.gitignore

# Local Python environment (Windows venv; would break a Linux image anyway)
venv/
.venv/
__pycache__/
*.pyc
*.egg-info/

# Stray Next.js/Node tooling artifacts -- no package.json in this repo at
# all, this app is Python/FastAPI only. Not just dead weight (1GB+): a
# broken path inside .next/dev/node_modules/ has crashed `az acr build`'s
# local tar-packing step outright before, well before .dockerignore would
# even apply.
node_modules/
.next/
.pytest_cache/

# Local SQLite database — mounted as a volume at runtime instead
lakehouse/*.db
lakehouse/*.db-*

# Input PDFs — mounted as a volume at runtime so files can change without a rebuild
sample_data/

# Docs (large reference PDFs, not needed at runtime)
docs/

# Docker files themselves don't need to be in the build context twice
Dockerfile
docker-compose.yml
.dockerignore

# Deployment staging artifacts (Terraform, docs) -- not needed inside the
# image. NOT container-start.sh: that's the App Service's actual startup
# command (see main.tf's app_command_line) and must exist inside the
# image, or the container silently falls back to whatever bare command
# was manually set as a workaround, skipping the Azure SQL migration step
# entirely -- exactly what happened here before this fix. Docker requires
# re-including parent directories explicitly to un-exclude a nested file.
deploy/**
!deploy/azure-app-service-demo/
!deploy/azure-app-service-demo/container-start.sh
deploy.zip

# Ad-hoc local output/backups, not build inputs
backup/
*.xlsx
JOBS_BACKUP_*.json
lakehouse/*.db.pre-migration-*

# Stray pre-migration SQLite backup files -- don't match the lakehouse/*.db-*
# pattern above (named ...db.pre-migration-NNN-backup, not ...db-*).
lakehouse/*.pre-migration-*-backup

# Throwaway test artifacts from extraction-work's Foundry test scripts --
# not needed at runtime, keeps the build context small.
test_output/
scripts/test_full_column_extraction.py
scripts/test_foundry_full_extraction.py
scripts/test_production_method_all_vendors.py
scripts/test_extraction_consistency.py
sample_data/Nucar Quonset 073026 2 (2) 3.pdf

# Secrets — never bake into the image, passed at runtime via env_file instead
.env
.env.*
!.env.example

# Version control
.git
.gitignore

# Local Python environment (Windows venv; would break a Linux image anyway)
venv/
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Local SQLite database — mounted as a volume at runtime instead
lakehouse/*.db
lakehouse/*.db-*

# Input PDFs — mounted as a volume at runtime so files can change without a rebuild
sample_data/

# Docs (large reference PDFs, not needed at runtime)
docs/

# Docker files themselves don't need to be in the build context twice
Dockerfile
docker-compose.yml
.dockerignore

# Throwaway test artifacts from extraction-work's Foundry test scripts --
# not needed at runtime, keeps the build context small.
test_output/
scripts/test_full_column_extraction.py
scripts/test_foundry_full_extraction.py
scripts/test_production_method_all_vendors.py
scripts/test_extraction_consistency.py
sample_data/Nucar Quonset 073026 2 (2) 3.pdf

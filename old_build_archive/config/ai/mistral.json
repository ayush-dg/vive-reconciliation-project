{
  "provider": "mistral",
  "model": "mistral-medium-latest",
  "api_key_env_var": "MISTRAL_API_KEY",
  "endpoint_env_var": "MISTRAL_ENDPOINT",
  "deployment_env_var": "MISTRAL_DEPLOYMENT",
  "dpi": 300,
  "temperature": 0.1,
  "max_output_tokens": 32000,
  "timeout_seconds": 300,
  "retry_policy": {
    "max_retries": 1,
    "backoff_seconds": 2,
    "backoff_multiplier": 2,
    "retry_on_status_codes": [429, 500, 502, 503, 504]
  }
}

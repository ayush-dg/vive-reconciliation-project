{
  "provider": "gemini",
  "model": "gemini-2.5-flash",
  "api_key_env_var": "GEMINI_API_KEY",
  "temperature": 0.1,
  "max_output_tokens": 65536,
  "timeout_seconds": 90,
  "thinking_budget": 0,
  "response_mime_type": "application/json",
  "retry_policy": {
    "max_retries": 2,
    "backoff_seconds": 2,
    "backoff_multiplier": 2,
    "retry_on_status_codes": [429, 500, 502, 503, 504]
  }
}

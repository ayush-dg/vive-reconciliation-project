{
  "provider": "groq",
  "model": "llama-3.3-70b-versatile",
  "api_key_env_var": "GROQ_API_KEY",
  "temperature": 0.1,
  "max_output_tokens": 4096,
  "timeout_seconds": 30,
  "retry_policy": {
    "max_retries": 2,
    "backoff_seconds": 1,
    "backoff_multiplier": 2,
    "retry_on_status_codes": [429, 500, 502, 503, 504]
  }
}

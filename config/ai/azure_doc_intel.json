{
  "provider": "azure_document_intelligence",
  "endpoint_env_var": "AZURE_DOC_INTEL_ENDPOINT",
  "api_key_env_var": "AZURE_DOC_INTEL_KEY",
  "model_id": "prebuilt-layout",
  "timeout_seconds": 90,
  "retry_policy": {
    "max_retries": 1,
    "backoff_seconds": 2,
    "backoff_multiplier": 2
  }
}

AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT_GPT5_MINI=gpt-5-mini
AZURE_OPENAI_DEPLOYMENT_GPT5_NANO=gpt-5-nano
AZURE_OPENAI_DEPLOYMENT_GPT5_1=gpt-5.1

AZURE_DOC_INTEL_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_DOC_INTEL_KEY=your-document-intelligence-key-here

# Claude Haiku 4.5, deployed via Azure AI Foundry (used by ClaudeClient /
# ExplanationService — see src/ai/claude_client.py). Anthropic Messages API
# wire format, just routed through an Azure-hosted deployment instead of
# api.anthropic.com directly.
AZURE_CLAUDE_ENDPOINT=https://your-resource-name.services.ai.azure.com/anthropic
AZURE_CLAUDE_API_KEY=your-azure-claude-key-here
AZURE_CLAUDE_DEPLOYMENT=claude-haiku-4-5

# Claude Sonnet 4.6 deployment on the same Foundry resource — used by
# ClaudeSonnetClient (src/ai/claude_sonnet_client.py), registered as an
# alternate extraction provider (not part of the active chain).
AZURE_CLAUDE_SONNET_DEPLOYMENT=claude-sonnet-4-6

# Azure Blob Storage connection string, used by src/storage/blob_client.py
# to archive every processed vendor PDF permanently (container: vendor-statements).
AZURE_BLOB_CONNECTION_STRING=your-connection-string-here

# Azure Blob Storage connection string for the auto-intake dropzone
# (storage account: viverecondropzone, container: incoming-statements),
# used by web/routers/intake_trigger.py's Event Grid webhook to download
# newly-landed vendor statement PDFs. A different storage account from
# AZURE_BLOB_CONNECTION_STRING above, which is archival-only.
AZURE_BLOB_DROPZONE_CONNECTION_STRING=your-connection-string-here

# Shared secret for web/routers/intake_trigger.py's Event Grid webhook.
# Generate a long random value and configure it as a static (secret)
# delivery header named x-vive-webhook-secret on the Event Grid
# subscription -- see https://learn.microsoft.com/azure/event-grid/delivery-properties.
# Required: if unset, every request to /api/intake-trigger is rejected.
VIVE_EVENTGRID_WEBHOOK_SECRET=your-random-webhook-secret-here
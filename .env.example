AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT_GPT5_MINI=gpt-5-mini
AZURE_OPENAI_DEPLOYMENT_GPT5_NANO=gpt-5-nano
AZURE_OPENAI_DEPLOYMENT_GPT5_1=gpt-5.1

AZURE_DOC_INTEL_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_DOC_INTEL_KEY=your-document-intelligence-key-here


AZURE_CLAUDE_ENDPOINT=https://your-resource-name.services.ai.azure.com/anthropic
AZURE_CLAUDE_API_KEY=your-azure-claude-key-here
AZURE_CLAUDE_DEPLOYMENT=claude-haiku-4-5


AZURE_CLAUDE_SONNET_DEPLOYMENT=claude-sonnet-4-6

AZURE_BLOB_CONNECTION_STRING=your-connection-string-here

AZURE_BLOB_DROPZONE_CONNECTION_STRING=your-connection-string-here

VIVE_EVENTGRID_WEBHOOK_SECRET=your-random-webhook-secret-here

# web/routers/mailbox_sync.py -- "Sync Outlook Now" button, calls the
# vive-mailbox-sync Azure Function (azure-functions/mailbox-sync/)
MAILBOX_SYNC_FUNCTION_URL=https://vive-mailbox-sync.azurewebsites.net/api/sync
MAILBOX_SYNC_FUNCTION_KEY=your-function-key-here
AZURE_BLOB_MAILBOX_CONNECTION_STRING=your-connection-string-here
# Shared secret the Function's 30-minute timer sends to /mailbox-sync/auto.
# Unset = that route rejects every call (automatic sync off).
MAILBOX_AUTOSYNC_SECRET=your-random-autosync-secret-here

FABRIC_SQLDB_ENDPOINT=your-sqldb-server.database.fabric.microsoft.com
FABRIC_SQLDB_NAME=your-database-name-here

# Bronze/Silver dbt pipeline (dbt/) -- service principal, not AzureCliCredential
FABRIC_CLIENT_ID=your-service-principal-client-id
FABRIC_CLIENT_SECRET=your-service-principal-client-secret
FABRIC_WORKSPACE_ID=your-fabric-workspace-id
FABRIC_LAKEHOUSE_NAME=your-lakehouse-name
FABRIC_LAKEHOUSE_ID=your-lakehouse-item-id
FABRIC_SQL_ENDPOINT_ID=your-sql-analytics-endpoint-item-id

# src/netsuite/client.py -- NetSuite SANDBOX write-back (OAuth1 TBA). The
# account id must look like 7321761-sb1 (or 7321761_SB1); anything else is refused.
SANDBOX_ACCOUNT_ID=your-sandbox-account-id
SANDBOX_CONSUMER_KEY=your-consumer-key
SANDBOX_CONSUMER_SECRET=your-consumer-secret
SANDBOX_TOKEN_ID=your-token-id
SANDBOX_TOKEN_SECRET=your-token-secret
# Base URL the write-back puts in statement PDF links (no trailing slash, no /login)
APP_PUBLIC_BASE_URL=https://vivecollision.azurewebsites.net

# Writes each statement's reconciliation result back into NetSuite (SANDBOX only)
# right after matching -- see src/netsuite/pipeline_hook.py. Off unless "true".
NETSUITE_WRITEBACK_ENABLED=true

# PDF link on bills/Statement Lines -- deferred, off unless "true" (see src/netsuite/writeback.py)
NETSUITE_WRITEBACK_PDF_LINK=false

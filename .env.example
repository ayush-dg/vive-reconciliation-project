# FABRIC_SQL_ENDPOINT — connection string/endpoint for the live `recon` SQL database
# in Microsoft Fabric. Required starting Session 4 (NetSuite/CCC ingestion has no
# meaningful local mock). Sessions 1-3: leave unset to fall back to a local SQLite
# database file for development, per Task 1.1's resolved default.
FABRIC_SQL_ENDPOINT=

# Local SQLite fallback file path. Only used when FABRIC_SQL_ENDPOINT is unset.
SQLITE_DB_PATH=./.data/recon.local.db

# Session secret used to sign the auth session cookie (Task 1.3). Generate a random
# value for real environments — this is a local-dev placeholder only.
SESSION_SECRET=dev-only-change-me

# Idle-timeout override, in milliseconds. Only set this in test runs — production
# uses the 30-minute default (UI_SURFACE.md's resolved default) when unset.
SESSION_IDLE_TIMEOUT_MS=

# Dev-user bootstrap (scripts/seed_users.mjs) — see that script's header comment
# for why this exists (no task provisions the first user account otherwise).
SEED_USER_USERNAME=dev.user
SEED_USER_PASSWORD=DevOnly-ChangeMe-123
